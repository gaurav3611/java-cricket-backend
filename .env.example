# Copy this file to .env. Every value is optional.

# Port to listen on.
PORT=5050

# Firebase service account key file. Without a key the API starts in demo mode:
# no sign-in checks and nothing is stored.
FIREBASE_SERVICE_ACCOUNT_PATH=serviceAccountKey.json

# The key can also be given as text in FIREBASE_SERVICE_ACCOUNT_JSON, which wins over the
# path. Set that one in the host's secret settings, not in this file.

# Folder with the static frontend to serve at /.
# FRONTEND_DIR=../Cricket/frontend
